/*
 * Roshni - Global UI Stylesheet
 *
 * This file defines the core visual identity of the game's UI,
 * including colors, fonts, and base styles for common elements.
 * It uses Unity's USS (Unity Style Sheets) format, which is a subset of CSS.
 */

/*
 * =========================================
 *  1. Root Variables (Color & Brand Palette)
 * =========================================
 * Define all brand colors here as custom properties. This allows for
 * easy reuse and theming.
 */
:root {
    /* Brand Colors */
    --color-primary: #7AA0FF;
    --color-secondary: #6CE7C1;
    --color-accent: #FFD166;

    /* Background & Text Colors */
    --color-bg: #FFFFFF;
    --color-text-primary: #1A1A1A;
    --color-text-secondary: #4D4D4D;

    /* Semantic Colors */
    --color-success: #31C48D;
    --color-warning: #F6AD55;
    --color-error: #F56565;

    /* Spacing & Radii from GDD */
    --spacing-unit: 12px;
    --border-radius: 24px;

    /* Motion & Animation from GDD */
    --motion-duration-default: 280ms;
}

/*
 * =========================================
 *  2. Typography
 * =========================================
 * Font definitions will be set here once the font assets (.ttf, .otf)
 * are imported into the project via the Unity Editor.
 */

